# ============================================================
# NyayaSaathi Backend Environment Variables
# Copy this file to .env and configure as needed
# ============================================================

# LLM Configuration
# When USE_MOCK_LLM=true, no API key is required (safe for local development/demo)
# To use real LLM, provide your API key and set USE_MOCK_LLM=false
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=google
USE_MOCK_LLM=true

# ChromaDB Vector Database
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=legal_documents

# Retrieval Settings
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3

# Frontend CORS Origin
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nyayasaathi

# JWT Authentication
JWT_SECRET_KEY=your_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth Credentials (for Google Sign-In backend verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

